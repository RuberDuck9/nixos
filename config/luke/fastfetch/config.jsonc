{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	"type": "auto",
	"padding": {
		"top": 3,
		"left": 3
	}
    },
    "display": {
        "color": {
            "keys": "#b7bdf8",
            "output": "#cad3f5"
        }
    },
    "percent": {
        "color": {
            "green": "#a6da95",
            "yellow": "#eed49f",
            "red": "#ed8796"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌───────────────────── Hardware ─────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "disk",
            "key": "└ └󰋊 ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌───────────────────── Software ─────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "bios",
            "key": "│ ├󰖡 ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "#b7bdf8"
        },
        "break",
        {
            "type": "de",
            "key": "󰧨  DE",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "terminal",
            "key": "└ └󰆍 ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌─────────────────── Uptime / Age / DT ──────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "keyColor": "#b7bdf8",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ›  Uptime  ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "datetime",
            "key": "  ›  DateTime  ",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
